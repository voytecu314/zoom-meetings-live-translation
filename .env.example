# --- Server ---
PORT=3000
NODE_ENV=development

# Public base URL used to build viewer links shown on the host page.
# OPTIONAL: leave it unset and the link is derived from the address the host
# opened the page with (works through tunnels/proxies). If you set it, it
# must be the URL your viewers can reach — NOT http://localhost:3000.
# PUBLIC_BASE_URL=https://subtitles.example.com

# Behind a reverse proxy / tunnel (Caddy, nginx, cloudflared, ngrok) keep this
# true so per-IP limits use X-Forwarded-For instead of the proxy's address.
TRUST_PROXY=true

# --- Translation provider ---
# mock      - dev-only provider, no network, no cost, returns marked-up text
# google-x  - google-translate-api-x (unofficial consumer endpoint; see README)
TRANSLATION_PROVIDER=mock

# Optional API key/credentials for providers that need one (none needed by default)
TRANSLATION_API_KEY=

# Max outgoing translation requests in flight at once (rate-limit protection)
TRANSLATION_CONCURRENCY=4

# Per-request translation timeout in milliseconds
TRANSLATION_TIMEOUT_MS=8000

# --- Sessions ---
# Seconds of host inactivity before a session expires (0 = never)
SESSION_TIMEOUT_SECONDS=3600

# Seconds viewers may remain connected after the host leaves (0 = immediately)
VIEWER_GRACE_SECONDS=60

# --- LIVE translation (utterance based; see README "How text is chunked") ---
# Fallback end-of-utterance if the host's pause signal is lost (ms).
PAUSE_THRESHOLD_MS=1800
# Finalize an utterance that gets this long even without a pause (words).
MAX_UTTERANCE_WORDS=40
# Live draft translations of the still-open utterance (extra requests).
DRAFT_TRANSLATIONS=true
DRAFT_INTERVAL_MS=1000
DRAFT_MIN_WORDS=3
DRAFT_MIN_NEW_WORDS=2

# --- Recognition / segmentation ---
# Buffer flush cap: if a segment grows beyond this many characters without
# terminal punctuation, a clause-boundary fallback is used (may translate
# mid-sentence; less accurate than full sentences). 0 disables the cap.
MAX_BUFFER_CHARS=

# --- Server-side transcription fallback (only needed if the chosen browser
# cannot run Web Speech recognition on captured Zoom tab audio; see README).
# whisper   - placeholder adapter; supply your own provider via /server/transcription
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_URL=
